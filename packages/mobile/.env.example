# Expo runtime environment template for Abareyo mobile builds.
# Copy to packages/mobile/.env (or export in CI) before running Expo commands.
# Each variable feeds into the Expo config, mirrors android/gradle.properties.example,
# and ios/Config.sample.xcconfig so native shells share the same API + OTP wiring.

# EXPO_PUBLIC_WEB_URL aligns with NEXT_PUBLIC_SITE_URL and tells Expo where to load
# the hosted onboarding screens rendered by the web bundle.
EXPO_PUBLIC_WEB_URL=https://fan-api.rayonsports.rw

# API_BASE_URL is injected into Expo metro config and forwarded to Auth/OTP helpers
# (see docs/mobile/whatsapp-auth.md) to talk to the backend REST API.
API_BASE_URL=https://fan-api.rayonsports.rw

# WhatsApp OTP settings bubble through src/lib/server/otp/whatsapp.ts, ensuring
# native OTP requests mirror the production backend templates.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=otp_verification
META_WABA_BASE_URL=https://graph.facebook.com/v20.0
